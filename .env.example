# StatSkill AI - Environment Configuration Template

APP_NAME="StatSkill AI"
APP_VERSION="1.0.0"
SECRET_KEY="statskill-mospi-karmayogi-secret-key-2026"

# Database connection (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///./statskill.db"

# AI Provider ("heuristic", "gemini", "openai", "ollama")
# By default, runs in 100% offline grounded heuristic mode without external keys.
AI_PROVIDER="heuristic"

# Optional External AI API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# iGOT Karmayogi Adapter Configuration
# Mode: "adapter_mock" for simulated compliant schema, "live_authorized" when authorized official OAuth2 credentials are provided
IGOT_MODE="adapter_mock"
IGOT_API_ENDPOINT="https://igot-mock.karmayogi.gov.in/api/v1"
